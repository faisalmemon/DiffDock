FROM ghcr.io/faisalmemon/DiffDock/diffdock-base:gb10-v1

# 2. Setup the User (The Base image used root, so we switch now)
ENV APPUSER="appuser"
RUN useradd -m -u 1000 $APPUSER
WORKDIR /home/$APPUSER/DiffDock
ENV PYTHONPATH="/home/$APPUSER/DiffDock:/opt/openfold:${PYTHONPATH}"

# 3. OpenFold - This is a "Heavy" build, so we keep it here 
# until you're sure it's stable, then you could move it to base too.
RUN git clone https://github.com/aqlaboratory/openfold.git /opt/openfold && \
    cd /opt/openfold && \
    sed -i 's/arch=compute_37,code=sm_37//g' setup.py && \
    sed -i 's/arch=compute_52,code=sm_52//g' setup.py && \
    sed -i 's/arch=compute_61,code=sm_61//g' setup.py && \
    sed -i 's/arch=compute_80,code=sm_80/arch=compute_90,code=sm_90/g' setup.py && \
    pip install .

# 4. Install Application-specific dependencies
# Note: Ensure your requirements.txt doesn't conflict with the base's torch/numpy
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# 5. Copy your local project code into the container
# This is the "COPY" you mentioned - it pulls in your DiffDock logic
COPY --chown=1000:1000 . .

# 6. Switch to non-root user for security (Good Darwin practice)
USER $APPUSER

# 7. Final preparation
RUN python utils/precompute_series.py

CMD ["python", "utils/print_device.py"]
