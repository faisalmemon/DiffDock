# Start with the official NVIDIA-optimized image
FROM nvcr.io/nvidia/pytorch:24.03-py3

# Set up your user
ENV APPUSER="appuser"
RUN useradd -m -u 1000 $APPUSER
WORKDIR /home/$APPUSER/DiffDock

# --- BUILD TOOLS & ENVIRONMENT ---
ENV TORCH_CUDA_ARCH_LIST="9.0"
ENV FORCE_CUDA="1"
ENV CFLAGS="-UI -U_Complex_I"

# Install the "Big Four" Geometric libraries from source
RUN pip install --no-cache-dir \
    torch-scatter \
    torch-sparse \
    torch-cluster \
    torch-spline-conv \
    -f https://data.pyg.org/whl/torch-2.3.0+cu121.html || \
    pip install --no-binary :all: torch-cluster torch-scatter torch-sparse torch-spline-conv

# Pre-install build-time requirements (must be done before ProDy surgery)
RUN pip install --no-cache-dir cython biopython setuptools numpy

# --- PRODY SURGERY BLOCK ---
RUN pip download prody==2.6.1 --no-binary :all: && \
    tar -xzf prody-2.6.1.tar.gz && \
    # We use \b to ensure we only replace the standalone variable 'I' 
    # and not parts of other words (like 'IF' or 'In').
    # We also undefine I at the very top of the file as a safety net.
    find prody-2.6.1 -name "rtbtools.c" -exec sed -i '1i #undef I' {} + && \
    find prody-2.6.1 -name "rtbtools.c" -exec sed -i 's/\bI\b/Inertia/g' {} + && \
    pip install ./prody-2.6.1/ --no-build-isolation && \
    rm -rf prody-*

# OpenFold porting (Hopper/Blackwell support)
RUN git clone https://github.com/aqlaboratory/openfold.git /opt/openfold && \
    cd /opt/openfold && \
    sed -i 's/arch=compute_37,code=sm_37//g' setup.py && \
    sed -i 's/arch=compute_52,code=sm_52//g' setup.py && \
    sed -i 's/arch=compute_61,code=sm_61//g' setup.py && \
    sed -i 's/arch=compute_80,code=sm_80/arch=compute_90,code=sm_90/g' setup.py && \
    pip install .

# Install remaining DiffDock dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy your code
COPY --chown=1000:1000 . .

# Precompute
RUN python utils/precompute_series.py

CMD ["python", "utils/print_device.py"]
