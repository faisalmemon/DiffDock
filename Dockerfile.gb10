FROM ghcr.io/faisalmemon/diffdock/diffdock-base:gb10-v1

LABEL org.opencontainers.image.source="https://github.com/faisalmemon/DiffDock"
LABEL org.opencontainers.image.description="DiffDock Application Layer optimized for Blackwell GB10"
LABEL org.opencontainers.image.authors="Faisal Memon"
LABEL version="1.0"

ENV APPUSER="appuser"
RUN useradd -m -u 1000 $APPUSER
WORKDIR /home/$APPUSER/DiffDock

# PYTHONPATH ensures Python finds your local code and the OpenFold installation
# NVIDIA_DISABLE_REQUIRE bypasses the Blackwell/Hopper version check
ENV PYTHONPATH="/home/$APPUSER/DiffDock:/opt/openfold:${PYTHONPATH}"
ENV NVIDIA_DISABLE_REQUIRE=true

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY --chown=1000:1000 . .

RUN python utils/precompute_series.py

RUN chown -R 1000:1000 /home/$APPUSER/DiffDock

USER $APPUSER

CMD ["python", "utils/print_device.py"]
